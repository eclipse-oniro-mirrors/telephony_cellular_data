import("//build/test.gni")
SOURCE_DIR = ".."

ohos_unittest("tel_cellular_data_ext_test") {
  subsystem_name = "telephony"
  part_name = "cellular_data"
  test_module = "cellular_data"
  test_suite = "tel_cellular_data_ext_test"
  module_out_path = part_name + "/" + test_module + "/" + test_suite

  # 与系统侧产品库（tel_cellular_data_static 等）保持相同的 CFI 配置：
  # cfi_cross_dso 开启后，系统 so 反向调用测试二进制内的函数（事件处理/mock 虚函数）
  # 需要在测试二进制的 __cfi_check 表中注册 type id，否则设备上运行时 CFI 校验失败
  # 直接 SIGABRT（整套件 unavailable）。
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  sources = [
    "$SOURCE_DIR/test/mock/mock_telephony_permission.cpp",
    "$SOURCE_DIR/test/apn_manager_test.cpp",
    "$SOURCE_DIR/test/cellular_data_handler_test.cpp",
    "$SOURCE_DIR/test/data_access_token.cpp",
    "$SOURCE_DIR/test/zero_branch_test.cpp",
    "$SOURCE_DIR/test/net_manager_call_back_test.cpp",
    "$SOURCE_DIR/test/cellular_data_power_save_mode_subscriber_test.cpp",
    "$SOURCE_DIR/test/cellular_data_rdb_helper_test.cpp",
    "$SOURCE_DIR/test/cellular_data_settings_rdb_helper_test.cpp",
    "$SOURCE_DIR/test/incall_data_state_machine_branch_test.cpp",
  ]

  include_dirs = [
    "$SOURCE_DIR/services/include",
    "$SOURCE_DIR/services/include/common",
    "$SOURCE_DIR/services/include/state_machine",
    "$SOURCE_DIR/services/include/utils",
    "$SOURCE_DIR/services/include/apn_manager",
    "$SOURCE_DIR/services/telephony_ext_wrapper/include",
    "$SOURCE_DIR/test/mock",
  ]

  deps = [
    "$SOURCE_DIR:tel_cellular_data_static",
    "$SOURCE_DIR/frameworks/native:cellulardata_interface_stub",
    "$SOURCE_DIR/frameworks/native:tel_cellular_data_api",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:abilitykit_native",
    "ability_runtime:data_ability_helper",
    "ability_runtime:dataobs_manager",
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "core_service:libtel_common",
    "core_service:tel_core_service_api",
    "data_share:datashare_common",
    "data_share:datashare_consumer",
    "eventhandler:libeventhandler",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_single",
    "netmanager_base:net_conn_manager_if",
    "netmanager_base:net_policy_manager_if",
    "netmanager_base:net_stats_manager_if",
    "preferences:native_preferences",
    "relational_store:native_dataability",
    "relational_store:native_rdb",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "telephony_data:tel_telephony_data",
  ]
  defines = [
    "TELEPHONY_LOG_TAG = \"CelllularDataTest\"",
    "LOG_DOMAIN = 0xD000F00",
  ]

  part_name = "cellular_data"
  subsystem_name = "telephony"
}

